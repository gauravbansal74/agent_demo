# Which LLM to use: "copilot" (GitHub Copilot SDK, default) or "anthropic" (Claude API)
LLM_PROVIDER=copilot

# GitHub Copilot, for LLM_PROVIDER=copilot. Leave the token unset to reuse your
# `copilot login` sign-in, or set a GitHub token with Copilot access (e.g. `gh auth token`).
# COPILOT_GITHUB_TOKEN=
# COPILOT_MODEL=gpt-5

# Claude API, only for LLM_PROVIDER=anthropic (key from https://console.anthropic.com)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_FALLBACKS=true         # server-side refusal fallback

# Optional overrides
# CLAUDE_EFFORT=medium          # reasoning effort: low | medium | high (both providers)
# BRAND_NAME=Sun Life
# MCP_CONFIG=mcp-servers.json   # which MCP servers to connect to
# PORT=3000

# Referenced from mcp-servers.json via ${...} when you point it at your own servers
# POLICY_MCP_URL=https://...
# POLICY_MCP_TOKEN=
# CLAIMS_MCP_URL=https://...
# CLAIMS_MCP_API_KEY=
