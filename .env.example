# Which LLM to use: "anthropic" (Claude API), "bedrock" (Claude on Amazon Bedrock)
# or "copilot" (GitHub Copilot SDK, for demos)
LLM_PROVIDER=anthropic

# Claude API key (https://console.anthropic.com), only for LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Amazon Bedrock, only for LLM_PROVIDER=bedrock. Credentials come from the
# standard AWS chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, AWS_PROFILE, or an IAM role).
# AWS_REGION=us-east-1
# AWS_PROFILE=

# GitHub Copilot, only for LLM_PROVIDER=copilot. A GitHub token for an account with Copilot
# (e.g. the output of `gh auth token`).
# COPILOT_GITHUB_TOKEN=
# COPILOT_MODEL=gpt-5

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5      # on Bedrock: anthropic.claude-opus-5-5
# CLAUDE_EFFORT=medium          # low | medium | high
# CLAUDE_FALLBACKS=true         # server-side refusal fallback; ignored on Bedrock
# BRAND_NAME=Sun Life
# MCP_CONFIG=mcp-servers.json   # which MCP servers to connect to
# PORT=3000

# Referenced from mcp-servers.json via ${...} when you point it at your own servers
# POLICY_MCP_URL=https://...
# POLICY_MCP_TOKEN=
# CLAIMS_MCP_URL=https://...
# CLAIMS_MCP_API_KEY=
