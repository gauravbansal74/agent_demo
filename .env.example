# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium          # low | medium | high
# CLAUDE_FALLBACKS=true         # server-side refusal fallback; set false on Bedrock/Vertex/Foundry
# BRAND_NAME=Sun Life
# MCP_CONFIG=mcp-servers.json   # which MCP servers to connect to
# PORT=3000

# Referenced from mcp-servers.json via ${...} when you point it at your own servers
# POLICY_MCP_URL=https://...
# POLICY_MCP_TOKEN=
# CLAIMS_MCP_URL=https://...
# CLAIMS_MCP_API_KEY=
